<div class="bad-hero">
  <h2>Summer Sale Is Here</h2>
  <p>Save up to 40% on everything in store</p>
  <a href="/collections/sale" class="bad-btn">Shop now</a>
  <script src="https://cdn.judge.me/widget.js"></script>
  {%- assign feat = all_products['blue-t-shirt'] -%}
  <p>{{ feat.title }}</p>
  <ul>
    <li class="card">{{ section.settings.unused_one }}</li>
    <li class="card">{{ section.settings.heading }}</li>
    <li class="card">{{ section.settings.never_defined }}</li>
  </ul>
</div>

{% stylesheet %}
.bad-hero {
  background: #f3f3f3;
  color: rgb(18, 18, 18);
  padding-top: 64px;
  font-family: Helvetica, Arial, sans-serif;
  font-size: 18px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Bad hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "unused_one", "label": "Unused" },
    { "type": "text", "id": "dead_setting", "label": "Dead" }
  ]
}
{% endschema %}
