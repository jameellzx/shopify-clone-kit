{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
-%}
<div
  class="ck-hero color-{{ section.settings.color_scheme }}"
  style="
    --ck-pad-top: {{ section.settings.padding_top }}px;
    --ck-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ck-gap: {{ section.settings.gap }}px;
    --ck-cols: {{ section.settings.columns_desktop }};
    --ck-cols-tablet: {{ section.settings.columns_tablet }};
    --ck-cols-mobile: {{ section.settings.columns_mobile }};
    --ck-max-width: {{ section.settings.content_width }}px;
    --ck-align: {{ section.settings.text_alignment }};
    --ck-bg: {{ section.settings.background_color }};
    --ck-fg: {{ section.settings.text_color }};
    --ck-accent: {{ section.settings.accent_color }};
    --ck-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ck-radius: {{ section.settings.corner_radius }}px;
    --ck-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --ck-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --ck-heading-size: {{ section.settings.heading_size }}px;
    --ck-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --ck-heading-weight: {{ section.settings.heading_weight }};
    --ck-body-size: {{ section.settings.body_size }}px;
    --ck-line-height: {{ section.settings.line_height }};
    --ck-letter-spacing: {{ section.settings.letter_spacing }}em;
  "
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_interval }}"
  data-animate="{{ section.settings.animation_style }}"
  {% if section.settings.full_width %}data-full-width{% endif %}
  {% if section.settings.sticky %}data-sticky{% endif %}
>
  {%- if section.settings.image != blank -%}
    <img
      class="ck-hero__media"
      src="{{ section.settings.image | image_url: width: 1600 }}"
      alt="{{ section.settings.image.alt | escape }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="{{ section.settings.image_loading }}"
    >
  {%- endif -%}

  <div class="ck-hero__inner">
    <h2 class="ck-hero__heading">{{ section.settings.heading }}</h2>
    <div class="ck-hero__body">{{ section.settings.subheading }}</div>

    {%- if section.settings.button_label != blank -%}
      <a class="ck-hero__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}

    {%- if section.settings.featured_product != blank -%}
      {%- assign fp = section.settings.featured_product -%}
      <p class="ck-hero__product">{{ fp.title }} {{ fp.selected_or_first_available_variant.price | money }}</p>
    {%- endif -%}

    <ul class="ck-hero__list">
      {%- for block in section.blocks -%}
        <li class="ck-hero__item" {{ block.shopify_attributes }}>
          <span class="ck-hero__item-title">{{ block.settings.item_title }}</span>
          <span class="ck-hero__item-text">{{ block.settings.item_text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
.ck-hero {
  position: relative;
  background: var(--ck-bg);
  color: var(--ck-fg);
  padding-top: var(--ck-pad-top);
  padding-bottom: var(--ck-pad-bottom);
  border-radius: var(--ck-radius);
  font-family: var(--ck-body-font);
  font-size: var(--ck-body-size);
  line-height: var(--ck-line-height);
  letter-spacing: var(--ck-letter-spacing);
  text-align: var(--ck-align);
}
.ck-hero__media {
  width: 100%;
  height: auto;
  opacity: var(--ck-overlay);
}
.ck-hero__inner {
  max-width: var(--ck-max-width);
  margin: 0 auto;
}
.ck-hero__heading {
  font-family: var(--ck-heading-font);
  font-size: var(--ck-heading-size-mobile);
  font-weight: var(--ck-heading-weight);
}
.ck-hero__button {
  color: var(--ck-accent);
}
.ck-hero__list {
  display: grid;
  gap: var(--ck-gap);
  grid-template-columns: repeat(var(--ck-cols-mobile), minmax(0, 1fr));
}
@media screen and (min-width: 750px) {
  .ck-hero__list { grid-template-columns: repeat(var(--ck-cols-tablet), minmax(0, 1fr)); }
  .ck-hero__heading { font-size: var(--ck-heading-size); }
}
@media screen and (min-width: 990px) {
  .ck-hero__list { grid-template-columns: repeat(var(--ck-cols), minmax(0, 1fr)); }
}
{% endstylesheet %}

{% javascript %}
class CkHero extends HTMLElement {
  connectedCallback() {
    this.interval = Number(this.dataset.interval || 0);
  }
}
document.addEventListener('shopify:section:load', () => {});
{% endjavascript %}

{% schema %}
{
  "name": "Clone hero",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1773b0" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 100 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "range", "id": "heading_size", "min": 16, "max": 96, "step": 1, "unit": "px", "label": "Heading size", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "min": 14, "max": 64, "step": 1, "unit": "px", "label": "Heading size (mobile)", "default": 32 },
    { "type": "range", "id": "heading_weight", "min": 100, "max": 900, "step": 100, "label": "Heading weight", "default": 700 },
    { "type": "range", "id": "body_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Body size", "default": 16 },
    { "type": "range", "id": "line_height", "min": 1, "max": 2, "step": 0.1, "label": "Line height", "default": 1.5 },
    { "type": "range", "id": "letter_spacing", "min": -1, "max": 3, "step": 0.1, "label": "Letter spacing", "default": 0 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 },
    { "type": "range", "id": "gap", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Gap", "default": 24 },
    { "type": "range", "id": "content_width", "min": 600, "max": 1600, "step": 20, "unit": "px", "label": "Content width", "default": 1200 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 0 },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 6, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "range", "id": "columns_tablet", "min": 1, "max": 4, "step": 1, "label": "Columns (tablet)", "default": 2 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 4, "step": 1, "label": "Columns (mobile)", "default": 1 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "checkbox", "id": "sticky", "label": "Sticky", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_loading", "label": "Image loading", "default": "lazy",
      "options": [ { "value": "lazy", "label": "Lazy" }, { "value": "eager", "label": "Eager" } ] },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "product", "id": "featured_product", "label": "Featured product" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "autoplay_interval", "min": 2, "max": 12, "step": 1, "unit": "s", "label": "Autoplay interval", "default": 5 },
    { "type": "select", "id": "animation_style", "label": "Animation", "default": "none",
      "options": [ { "value": "none", "label": "None" }, { "value": "fade", "label": "Fade in" }, { "value": "slide", "label": "Slide up" } ] }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "item_title", "label": "Title" },
        { "type": "richtext", "id": "item_text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Clone hero", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
